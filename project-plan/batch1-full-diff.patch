@@ -0,0 +1,291 @@
+import type { ApprovalRecord, AttemptRecord, CurrentAttemptSnapshot, GateVerdict, StepState, StepStatus } from './types.ts'
+import { STEP_BY_ID } from './steps.ts'
+
+/**
+ * State machine for the 16-step research engine (F-W1 gap — newly created).
+ *
+ * Enforces:
+ *  - input dependency: a step may not start until every slug in its `inputs`
+ *    has been produced as an artifact somewhere in the store;
+ *  - gate adjudication: a step may not exit until every component in its
+ *    `gate` has a verdict; all-passed → 'passed' (or 'gated' for humanGate steps,
+ *    which then require approveHumanGate to reach 'passed' — INV-HUMAN-1),
+ *    falsifiable C-fail → 'failed', other fail → 'blocked';
+ *  - legal StepStatus transitions: pending → in_progress → gated →
+ *    passed/blocked/failed, with rollback reverting to 'pending'.
+ *
+ * Rollback semantics (D4 回退): snapshot the current attempt into `history`
+ * (never physically cleared — INV-ROLLBACK-2) and reset live fields to a fresh
+ * initial state, enabling a re-run via startStep. `attempt_id` is not advanced
+ * here; startStep advances it on the next run. The cascade is emergent —
+ * downstream consumers of this step's outputs lose those inputs (current
+ * artifacts reset to {}), so their canStart returns false until re-produced
+ * (INV-ROLLBACK-1: projection reads only the current attempt). `attempts` is
+ * retained across rollback for diagnostics.
+ */
+
+/** Mutable map of step runtime states, keyed by step id. */
+export type StepStore = Map<string, StepState>
+
+/** Legal forward edges; terminal states allow none. Rollback (any → pending) is performed via rollback(), not transition(). */
+const LEGAL_TRANSITIONS: Readonly<Record<StepStatus, ReadonlySet<StepStatus>>> = {
+  pending: new Set<StepStatus>(['in_progress']),
+  in_progress: new Set<StepStatus>(['gated']),
+  gated: new Set<StepStatus>(['passed', 'blocked', 'failed']),
+  passed: new Set<StepStatus>(),
+  blocked: new Set<StepStatus>(),
+  failed: new Set<StepStatus>(),
+}
+
+function ensureEntry(stepId: string, store: StepStore): StepState {
+  const existing = store.get(stepId)
+  if (existing) return existing
+  const state: StepState = {
+    stepId,
+    status: 'pending',
+    attempts: 0,
+    attempt_id: 0,
+    artifacts: {},
+    gateResults: {},
+    approval: undefined,
+    history: [],
+    startedAt: undefined,
+    finishedAt: undefined,
+  }
+  store.set(stepId, state)
+  return state
+}
+
+/**
+ * True iff the step is pending (or has no state yet, which is implicitly pending)
+ * and every input slug has been produced as an artifact somewhere in the store.
+ */
+export function canStart(stepId: string, store: Readonly<StepStore>): boolean {
+  const step = STEP_BY_ID.get(stepId)
+  if (!step) return false
+  const state = store.get(stepId)
+  const status: StepStatus = state?.status ?? 'pending'
+  if (status !== 'pending') return false
+  for (const slug of step.inputs) {
+    let produced = false
+    for (const other of store.values()) {
+      if (slug in other.artifacts) {
+        produced = true
+        break
+      }
+    }
+    if (!produced) return false
+  }
+  return true
+}
+
+/** Move a pending step whose inputs are ready to in_progress. Throws if it cannot start. */
+export function startStep(stepId: string, store: StepStore): StepState {
+  if (!canStart(stepId, store)) {
+    throw new Error(`state-machine.startStep: cannot start '${stepId}' (not pending or inputs missing)`)
+  }
+  const state = ensureEntry(stepId, store)
+  state.status = 'in_progress'
+  state.startedAt = Date.now()
+  state.attempts += 1
+  state.attempt_id = state.attempts
+  return state
+}
+
+/** Record a produced output artifact. The step must be in_progress. */
+export function recordArtifact(stepId: string, outputSlug: string, value: unknown, store: StepStore): void {
+  const state = store.get(stepId)
+  if (!state || state.status !== 'in_progress') {
+    throw new Error(`state-machine.recordArtifact: step '${stepId}' is not in_progress`)
+  }
+  state.artifacts[outputSlug] = value
+}
+
+/**
+ * Submit one trinity-component gate verdict. Adjudicates once every component
+ * in the step's `gate` has a verdict: all-passed → 'passed' (or 'gated' for a
+ * humanGate step, which then awaits approveHumanGate — INV-HUMAN-1); any fail on
+ * a falsifiable step's component C → 'failed'; any other fail → 'blocked'.
+ * An empty gate adjudicates immediately on submit (humanGate → 'gated',
+ * non-humanGate → 'passed'). Returns the resulting status.
+ */
+export function submitGateVerdict(stepId: string, verdict: GateVerdict, store: StepStore): StepStatus {
+  const step = STEP_BY_ID.get(stepId)
+  if (!step) throw new Error(`state-machine.submitGateVerdict: unknown step '${stepId}'`)
+  const state = store.get(stepId)
+  if (!state) throw new Error(`state-machine.submitGateVerdict: no state for '${stepId}'`)
+  if (state.status !== 'in_progress' && state.status !== 'gated') {
+    throw new Error(`state-machine.submitGateVerdict: step '${stepId}' status '${state.status}' cannot accept verdicts`)
+  }
+  state.gateResults[verdict.component] = verdict
+
+  if (step.gate.length === 0) {
+    // INV-HUMAN-1: a humanGate step with an empty gate must not auto-pass; it parks
+    // in 'gated' awaiting explicit human approval via approveHumanGate. A non-humanGate
+    // step with an empty gate passes immediately.
+    if (step.humanGate) {
+      state.status = 'gated'
+      // finishedAt intentionally left unset until approveHumanGate.
+    } else {
+      state.status = 'passed'
+      state.finishedAt = Date.now()
+    }
+    return state.status
+  }
+
+  // Not all gate components in yet — stay in_progress/gated.
+  for (const comp of step.gate) {
+    if (!(comp in state.gateResults)) return state.status
+  }
+
+  // All in: adjudicate.
+  let anyFail = false
+  let cFailOnFalsifiable = false
+  for (const comp of step.gate) {
+    const v = state.gateResults[comp]
+    if (v && !v.passed) {
+      anyFail = true
+      if (step.falsifiable !== null && comp === 'C') cFailOnFalsifiable = true
+    }
+  }
+  if (!anyFail) {
+    if (step.humanGate) {
+      // INV-HUMAN-1: automated gates all passed, but a humanGate step still requires
+      // explicit human approval before 'passed'; park in 'gated' (finishedAt unset).
+      state.status = 'gated'
+    } else {
+      state.status = 'passed'
+      state.finishedAt = Date.now()
+    }
+  } else if (cFailOnFalsifiable) {
+    state.status = 'failed'
+    state.finishedAt = Date.now()
+  } else {
+    state.status = 'blocked'
+    state.finishedAt = Date.now()
+  }
+  return state.status
+}
+
+/** Guarded legal-edge transition. Throws on illegal edges. */
+export function transition(stepId: string, to: StepStatus, store: StepStore): void {
+  const state = store.get(stepId)
+  if (!state) throw new Error(`state-machine.transition: no state for '${stepId}'`)
+  const allowed = LEGAL_TRANSITIONS[state.status]
+  if (!allowed || !allowed.has(to)) {
+    throw new Error(`state-machine.transition: illegal '${state.status}' -> '${to}' for '${stepId}'`)
+  }
+  // INV-HUMAN-1: a humanGate step may not enter 'passed' via transition without an
+  // explicit approved human approval record (prevents bypassing approveHumanGate).
+  if (to === 'passed') {
+    const step = STEP_BY_ID.get(stepId)
+    if (step?.humanGate && state.approval?.decision !== 'approved') {
+      throw new Error(`state-machine.transition: humanGate step '${stepId}' cannot move to 'passed' without an approved human approval`)
+    }
+  }
+  state.status = to
+  if (to === 'passed' || to === 'blocked' || to === 'failed') {
+    state.finishedAt = Date.now()
+  }
+}
+
+/**
+ * D4 回退: snapshot the current attempt into history (never physically cleared) and
+ * reset the live fields to a fresh initial state, enabling a re-run via startStep.
+ * `attempt_id` is NOT advanced here — startStep advances it on the next run (so
+ * `attempts`/`attempt_id` count real runs only). The `clearArtifacts` option is
+ * deprecated and ignored: INV-ROLLBACK-2 forbids physically clearing gateResults or
+ * artifacts; both are preserved in the superseded snapshot appended to `history`.
+ * Cascade is emergent: downstream consumers lose this step's current outputs
+ * (artifacts reset to {}), so their canStart returns false until re-produced.
+ */
+export function rollback(stepId: string, store: StepStore, opts?: { clearArtifacts?: boolean }): void {
+  void opts // 'clearArtifacts' deprecated; physical clearing forbidden (INV-ROLLBACK-2).
+  const state = store.get(stepId)
+  if (!state) throw new Error(`state-machine.rollback: no state for '${stepId}'`)
+  // Append a superseded snapshot of the current attempt (preserve evidence; do not clear).
+  const snapshot: AttemptRecord = {
+    attempt_id: state.attempt_id,
+    status: state.status,
+    artifacts: state.artifacts,
+    gateResults: state.gateResults,
+    approval: state.approval,
+    superseded: true,
+  }
+  state.history.push(snapshot)
+  // Reset live fields to a fresh new-attempt initial state. Reassigning to new objects
+  // leaves the snapshot's references untouched (append-only history; INV-ROLLBACK-2).
+  state.status = 'pending'
+  state.artifacts = {}
+  state.gateResults = {}
+  state.approval = undefined
+  state.startedAt = undefined
+  state.finishedAt = undefined
+}
+
+/** True iff the step has reached 'passed' (and, for humanGate steps, holds an approved
+ *  human approval record for the current attempt). */
+export function isComplete(stepId: string, store: Readonly<StepStore>): boolean {
+  const state = store.get(stepId)
+  if (!state || state.status !== 'passed') return false
+  const step = STEP_BY_ID.get(stepId)
+  if (step?.humanGate) {
+    return state.approval?.decision === 'approved'
+  }
+  return true
+}
+
+/**
+ * Apply a human approval to a humanGate step currently in 'gated' (INV-HUMAN-1).
+ * Validates that the approval is bound to this step + the current attempt_id and that
+ * the actor is not 'agent'. 'approved' → 'passed' (sets finishedAt); 'rejected' → 'blocked'
+ * (approval retained as evidence). Returns the resulting status.
+ */
+export function approveHumanGate(stepId: string, approval: ApprovalRecord, store: StepStore): StepStatus {
+  const step = STEP_BY_ID.get(stepId)
+  if (!step) throw new Error(`state-machine.approveHumanGate: unknown step '${stepId}'`)
+  if (!step.humanGate) {
+    throw new Error(`state-machine.approveHumanGate: step '${stepId}' is not a humanGate step`)
+  }
+  const state = store.get(stepId)
+  if (!state) throw new Error(`state-machine.approveHumanGate: no state for '${stepId}'`)
+  if (state.status !== 'gated') {
+    throw new Error(`state-machine.approveHumanGate: step '${stepId}' status '${state.status}' is not 'gated'`)
+  }
+  if (approval.step_id !== stepId) {
+    throw new Error(`state-machine.approveHumanGate: approval.step_id '${approval.step_id}' does not match '${stepId}'`)
+  }
+  if (approval.attempt_id !== state.attempt_id) {
+    throw new Error(`state-machine.approveHumanGate: approval.attempt_id ${approval.attempt_id} does not match current attempt_id ${state.attempt_id} (stale approvals cannot be reused)`)
+  }
+  if (!approval.actor || approval.actor === 'agent') {
+    throw new Error(`state-machine.approveHumanGate: actor 'agent' (or empty) is not allowed for human approval`)
+  }
+  state.approval = approval
+  if (approval.decision === 'approved') {
+    state.status = 'passed'
+    state.finishedAt = Date.now()
+  } else {
+    state.status = 'blocked'
+    state.finishedAt = Date.now()
+  }
+  return state.status
+}
+
+/**
+ * Audit view: the full attempt history (superseded snapshots) followed by the current
+ * attempt snapshot (INV-ROLLBACK-2). Append-only; rollback never physically clears.
+ */
+export function getAuditHistory(stepId: string, store: Readonly<StepStore>): (AttemptRecord | CurrentAttemptSnapshot)[] {
+  const state = store.get(stepId)
+  if (!state) return []
+  const current: CurrentAttemptSnapshot = {
+    attempt_id: state.attempt_id,
+    status: state.status,
+    artifacts: state.artifacts,
+    gateResults: state.gateResults,
+    approval: state.approval,
+    current: true,
+  }
+  return [...state.history, current]
+}
