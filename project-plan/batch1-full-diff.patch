+/**
+ * Thin Cordis adapter wrapping the pure dsh-research-core 16-step research
+ * engine.
+ *
+ * Registers `ctx.research` — a {@link ResearchEngine} service that holds one
+ * in-memory {@link StepStore} and delegates every operation to the pure core
+ * (no state-machine logic is duplicated here). The Service base registers the
+ * instance on `ctx` (auto-unregister on owning-fiber unload); `[Service.init]`
+ * adds an unload effect clearing the store.
+ *
+ * The "name / inject / Config / apply" three-piece is satisfied by the cordis
+ * class-plugin convention: `name` via `super(ctx, 'research')`, `Config` as a
+ * static schema, and `apply` via `ctx.plugin(ResearchEngine, config)` →
+ * constructor + `[Service.init]` (the loader's apply step). No state-machine
+ * logic is reimplemented; the pure core functions are called as-is.
+ *
+ * @module @deepseek-ai/dsh-research-cordis
+ */
+
+import { Context, Service } from '@deepseek-ai/cordis'
+import z from '@deepseek-ai/schemastery'
+import {
+  approveHumanGate,
+  canStart,
+  getAuditHistory,
+  isComplete,
+  recordArtifact,
+  rollback,
+  startStep,
+  submitGateVerdict,
+  transition,
+} from '@deepseek-ai/dsh-research-core'
+import type {
+  ApprovalRecord,
+  AttemptRecord,
+  CurrentAttemptSnapshot,
+  GateVerdict,
+  StepState,
+  StepStatus,
+  StepStore,
+} from '@deepseek-ai/dsh-research-core'
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    research: ResearchEngine
+  }
+}
+
+/** Adapter config (currently empty — the pure engine is config-less). */
+export interface Config {}
+
+/**
+ * Cordis service (`ctx.research`) wrapping the pure dsh-research-core state
+ * machine. Holds one in-memory {@link StepStore}; every method delegates to
+ * the pure core functions, so no transition, gate-adjudication, or rollback
+ * logic is duplicated.
+ *
+ * State is held in a TS-private (not ECMAScript `#private`) field: cordis
+ * proxies service method calls, and `#private` brand checks fail against the
+ * proxy receiver. A regular private field forwards through the proxy.
+ */
+export class ResearchEngine extends Service {
+  static Config: z<Config> = z.object({})
+
+  private readonly store: StepStore
+
+  constructor(ctx: Context, config: Config = {}) {
+    super(ctx, 'research')
+    void config
+    this.store = new Map<string, StepState>()
+  }
+
+  /** Load: register an unload effect clearing the in-memory store. */
+  async [Service.init](): Promise<void> {
+    this.ctx.effect(() => async () => {
+      this.store.clear()
+    }, 'research.store')
+  }
+
+  canStart(stepId: string): boolean {
+    return canStart(stepId, this.store)
+  }
+
+  startStep(stepId: string) {
+    return startStep(stepId, this.store)
+  }
+
+  recordArtifact(stepId: string, outputSlug: string, value: unknown): void {
+    recordArtifact(stepId, outputSlug, value, this.store)
+  }
+
+  submitGateVerdict(stepId: string, verdict: GateVerdict): StepStatus {
+    return submitGateVerdict(stepId, verdict, this.store)
+  }
+
+  transition(stepId: string, to: StepStatus): void {
+    transition(stepId, to, this.store)
+  }
+
+  rollback(stepId: string): void {
+    rollback(stepId, this.store)
+  }
+
+  isComplete(stepId: string): boolean {
+    return isComplete(stepId, this.store)
+  }
+
+  approveHumanGate(stepId: string, approval: ApprovalRecord): StepStatus {
+    return approveHumanGate(stepId, approval, this.store)
+  }
+
+  getAuditHistory(stepId: string): (AttemptRecord | CurrentAttemptSnapshot)[] {
+    return getAuditHistory(stepId, this.store)
+  }
+}
+
+export default ResearchEngine
