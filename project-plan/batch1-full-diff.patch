+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { ResearchEngine } from '../src/index.ts'
+import type { ApprovalRecord } from '@deepseek-ai/dsh-research-core'
+
+// P1.6 thin Cordis adapter over the pure dsh-research-core. These cover the
+// three lifecycle seams the scope requires — load (ctx.plugin registers the
+// service + runs [Service.init]), unload (fiber.dispose runs the ctx.effect
+// cleanup + unregisters), and error propagation (core invariants throw
+// through the service, never swallowed). They exercise the adapter wiring only;
+// the state-machine behavior itself is pinned by dsh-research-core's own suite.
+
+describe('ResearchEngine Cordis adapter (P1.6)', () => {
+  it('loads: ctx.plugin registers ctx.research and runs [Service.init]', async () => {
+    const ctx = new Context()
+    await ctx.plugin(ResearchEngine)
+    expect(ctx.research).toBeInstanceOf(ResearchEngine)
+    // Delegates to the pure core: an unknown step has no produced inputs, so
+    // canStart returns false (the core's own contract), proving the service
+    // forwards to the core rather than reimplementing the check.
+    expect(ctx.research.canStart('nonexistent-step')).toBe(false)
+  })
+
+  it('unloads: disposing the fiber unregisters ctx.research (cleanup effect runs)', async () => {
+    const ctx = new Context()
+    await ctx.plugin(ResearchEngine)
+    expect(ctx.research).toBeInstanceOf(ResearchEngine)
+    await ctx.fiber.dispose()
+    expect(ctx.research as ResearchEngine | undefined).toBeUndefined()
+  })
+
+  it('propagates core errors: startStep on a step that cannot start throws (not swallowed)', async () => {
+    const ctx = new Context()
+    await ctx.plugin(ResearchEngine)
+    // startStep guards on canStart; an unknown step cannot start, so the pure
+    // core throws — and the service surfaces it unchanged.
+    expect(() => ctx.research.startStep('nonexistent-step')).toThrow(/cannot start/)
+  })
+
+  it('propagates the INV-HUMAN-1 invariant: approveHumanGate surfaces the core rejection', async () => {
+    const ctx = new Context()
+    await ctx.plugin(ResearchEngine)
+    // E2-submit is a humanGate step but has no state here, so the pure core
+    // rejects the approval (no state / not gated); the service propagates the
+    // error instead of masking it.
+    const bad: ApprovalRecord = {
+      run_id: 'r1',
+      step_id: 'E2-submit',
+      attempt_id: 1,
+      actor: 'agent',
+      decision: 'approved',
+      timestamp: 0,
+    }
+    expect(() => ctx.research.approveHumanGate('E2-submit', bad)).toThrow()
+  })
+})
