{
  "name": "@deepseek-ai/dsh-research-cordis",
  "description": "Thin Cordis adapter wrapping the pure dsh-research-core 16-step research engine (ctx.research service)",
  "version": "0.1.2-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-research-core": "workspace:^",
    "@deepseek-ai/dsh-research-tools": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@deepseek-ai/dsh-research-core": "workspace:^",
    "@deepseek-ai/dsh-research-tools": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
